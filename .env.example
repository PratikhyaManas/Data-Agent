# LLM Configuration
ANTHROPIC_API_KEY=your_claude_api_key

# Optional: model selection per complexity tier
LLM_MODEL_LOW=claude-haiku-4-5-20251001
LLM_MODEL_MEDIUM=claude-sonnet-5
LLM_MODEL_HIGH=claude-opus-4-8

# Optional: retry/fallback resilience (see utils/llm_pick.py)
LLM_MAX_RETRIES_PER_MODEL=3
LLM_BASE_BACKOFF_SECONDS=1.0
LLM_MAX_BACKOFF_SECONDS=20.0

# SQLite DB path (no server needed)
DB_PATH=data/data_agent.db

# Optional: query cache (see utils/query_cache.py)
QUERY_CACHE_PATH=data/query_cache.json
QUERY_CACHE_TTL_SECONDS=86400

# Optional: audit log rotation (see utils/audit.py)
AUDIT_LOG_MAX_BYTES=10485760
